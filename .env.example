# ---------------------------------------------------------------------------
# JobPilot configuration. Copy to .env.local and adjust.
# Never commit real secrets. Nothing below is exposed to the browser except
# variables prefixed with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Public base URL of the app (used for redirects in emails and absolute links).
APP_URL=http://localhost:3000

# Authentication backend:
#   local    - email/password stored in the local database (development, demo, tests)
#   supabase - Supabase Auth (recommended for any deployed instance)
AUTH_MODE=local

# PostgreSQL connection string. Locally: `npm run db:local:start` or
# `docker compose up -d db`. For Supabase use the "Session pooler" connection
# string from Project Settings -> Database.
DATABASE_URL=postgres://postgres@127.0.0.1:54329/jobpilot

# Signs local-mode session cookies. Generate with: openssl rand -base64 32
# Required when AUTH_MODE=local. Must be at least 32 characters.
SESSION_SECRET=replace-me-with-a-long-random-string-of-32-chars-or-more

# Supabase (only needed when AUTH_MODE=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used exclusively for account deletion. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Where original resume files are stored: local (./.data/uploads) or supabase.
# Defaults to the AUTH_MODE value.
STORAGE_MODE=

# AI provider:
#   mock   - deterministic, offline, clearly labelled demo output (default)
#   openai - any OpenAI-compatible Chat Completions API with JSON output
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# Model identifier offered by your provider, e.g. gpt-4.1-mini
AI_MODEL=
# json_schema (structured outputs) or json_object for providers without schema support
AI_JSON_MODE=json_schema
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
# Maximum AI operations per user per hour (applies to every provider)
AI_RATE_LIMIT_PER_HOUR=60
