# Copy to deploy/.env and set every value marked CHANGE. Never commit the real file.

# PostgreSQL superuser for the bundled database container (local only).
POSTGRES_PASSWORD=CHANGE-local-postgres-password

# Runtime role passwords. db/init/00-roles.sql creates the roles with development
# defaults; the compose stack resets them to these values.
SKYWATCH_API_DB_PASSWORD=CHANGE-api-role-password
SKYWATCH_WORKER_DB_PASSWORD=CHANGE-worker-role-password

# Key-encryption key(s) for credentials: "id:base64(32 bytes)", first = active.
# Generate: openssl rand -base64 32
SKYWATCH_KEKS=v1:CHANGE-base64-32-byte-key

# Shared secret between the management API and the backend control listener.
SKYWATCH_CONTROL_TOKEN=CHANGE-long-random-string

# Signs short-lived OIDC state cookies.
SKYWATCH_COOKIE_SECRET=CHANGE-long-random-string

# Password for the seeded local demo users (admin@demo.local, operator@demo.local, ...).
SKYWATCH_DEMO_PASSWORD=CHANGE-demo-password

SKYWATCH_PUBLIC_URL=http://localhost:3000
SKYWATCH_INGEST_PUBLIC_URL=http://localhost:8443

# Optional SSO (OIDC). Redirect URI: ${SKYWATCH_PUBLIC_URL}/api/v1/auth/oidc/callback
SKYWATCH_OIDC_ISSUER=
SKYWATCH_OIDC_CLIENT_ID=
SKYWATCH_OIDC_CLIENT_SECRET=

# Optional email notifications.
SKYWATCH_SMTP_ADDR=
SKYWATCH_SMTP_FROM=skywatch@example.com
SKYWATCH_SMTP_USER=
SKYWATCH_SMTP_PASSWORD=
