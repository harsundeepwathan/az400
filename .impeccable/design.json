  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one filled Action Green action in a view.",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M7 4.5v15l13-7.5z\"/></svg>Start workout</button>",
      "css": ".ds-btn-primary{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;min-height:52px;padding:0 24px;border:0;border-radius:16px;background:#008A55;color:#FFFFFF;font:600 17px -apple-system,BlinkMacSystemFont,\"SF Pro Text\",system-ui,sans-serif;cursor:pointer;transition:transform .28s cubic-bezier(0.23,1,0.32,1),opacity .28s cubic-bezier(0.23,1,0.32,1)}.ds-btn-primary:hover{opacity:.96}.ds-btn-primary:active{transform:scale(.98);opacity:.92;transition-duration:.1s}.ds-btn-primary:focus-visible{outline:3px solid #007A4C;outline-offset:2px}.ds-btn-primary:disabled{background:#6E6E73}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Tinted companion to the primary; never filled.",
      "html": "<button class=\"ds-btn-secondary\">Keep current</button>",
      "css": ".ds-btn-secondary{display:flex;align-items:center;justify-content:center;width:100%;min-height:52px;padding:0 16px;border:0;border-radius:16px;background:#E2F4EA;color:#007A4C;font:600 17px -apple-system,BlinkMacSystemFont,\"SF Pro Text\",system-ui,sans-serif;cursor:pointer;transition:transform .28s cubic-bezier(0.23,1,0.32,1)}.ds-btn-secondary:active{transform:scale(.98);transition-duration:.1s}.ds-btn-secondary:focus-visible{outline:3px solid #007A4C;outline-offset:2px}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Neutral well-filled button for toolbars and grids.",
      "html": "<button class=\"ds-btn-quiet\">Add note</button>",
      "css": ".ds-btn-quiet{min-height:44px;padding:0 12px;border:0;border-radius:10px;background:#EDEDF1;color:#000;font:600 15px -apple-system,BlinkMacSystemFont,\"SF Pro Text\",system-ui,sans-serif;cursor:pointer;transition:transform .28s cubic-bezier(0.23,1,0.32,1),opacity .28s}.ds-btn-quiet:active{transform:scale(.97);opacity:.7;transition-duration:.1s}.ds-btn-quiet:focus-visible{outline:3px solid #007A4C;outline-offset:2px}"
    },
    {
      "name": "Category Header",
      "kind": "custom",
      "refersTo": "category-header",
      "description": "First line of a cell: category-tinted symbol and label, trailing detail.",
      "html": "<div class=\"ds-cat\"><span class=\"ds-cat-l\" style=\"color:#E5521A\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><path d=\"M7 3v8a2 2 0 0 0 2 2v8M5 3v6M9 3v6M17 3c-2 0-3 2.5-3 6s1 4 3 4v8\"/></svg>Nutrition</span><button class=\"ds-cat-r\">Details<svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 6l6 6-6 6\"/></svg></button></div><div class=\"ds-cat\"><span class=\"ds-cat-l\" style=\"color:#008A55\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"8\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M12 1.5v4M12 18.5v4M1.5 12h4M18.5 12h4\"/></svg>Coach</span><span class=\"ds-cat-r\">Today</span></div>",
      "css": ".ds-cat{display:flex;align-items:center;gap:6px;min-height:44px;font:600 15px -apple-system,BlinkMacSystemFont,\"SF Pro Text\",system-ui,sans-serif}.ds-cat-l{display:flex;align-items:center;gap:6px}.ds-cat-r{margin-left:auto;display:flex;align-items:center;gap:2px;background:none;border:0;padding:0;font:400 15px -apple-system,BlinkMacSystemFont,\"SF Pro Text\",system-ui,sans-serif;color:#6C6C70;cursor:pointer}button.ds-cat-r:hover{color:#000}button.ds-cat-r:focus-visible{outline:3px solid #007A4C;outline-offset:2px;border-radius:6px}"
    },
    {
      "name": "Cell",
      "kind": "card",
      "refersTo": "cell",
      "description": "Flat white grouped cell on the grey ground: header, one statement, numbers, one action.",
      "html": "<div class=\"ds-ground\"><div class=\"ds-cell\"><div class=\"ds-cell-cat\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"8\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M12 1.5v4M12 18.5v4M1.5 12h4M18.5 12h4\"/></svg>Coach</div><p class=\"ds-cell-t\">Everything is on track, no changes</p><p class=\"ds-cell-s\">Your weight is moving at the planned rate.</p></div></div>",
      "css": ".ds-ground{background:#F2F2F7;padding:16px}.ds-cell{background:#FFFFFF;border-radius:14px;padding:16px;display:flex;flex-direction:column;gap:12px;font-family:-apple-system,BlinkMacSystemFont,\"SF Pro Text\",system-ui,sans-serif}.ds-cell-cat{display:flex;align-items:center;gap:6px;color:#008A55;font:600 15px -apple-system,BlinkMacSystemFont,\"SF Pro Text\",system-ui,sans-serif}.ds-cell-t{margin:0;font:700 22px/28px -apple-system,BlinkMacSystemFont,\"SF Pro Text\",system-ui,sans-serif;color:#000}.ds-cell-s{margin:0;font:400 15px/20px -apple-system,BlinkMacSystemFont,\"SF Pro Text\",system-ui,sans-serif;color:#6C6C70}"
    },
    {
      "name": "Metric View",
      "kind": "custom",
      "refersTo": "metric",
      "description": "Caption label, rounded bold tabular value, unit and delta.",
      "html": "<div class=\"ds-metric\"><span class=\"ds-metric-l\">Previous volume</span><span class=\"ds-metric-v\">12,480<small>kg</small></span><span class=\"ds-delta\">&#8599; +8.4%</span></div>",
      "css": ".ds-metric{display:flex;flex-direction:column;gap:2px;font-family:-apple-system,BlinkMacSystemFont,\"SF Pro Text\",system-ui,sans-serif}.ds-metric-l{font:500 12px -apple-system,BlinkMacSystemFont,\"SF Pro Text\",system-ui,sans-serif;color:#6C6C70}.ds-metric-v{font:700 22px/28px ui-rounded,\"SF Pro Rounded\",-apple-system,sans-serif;font-variant-numeric:tabular-nums;color:#000}.ds-metric-v small{font:400 15px -apple-system,BlinkMacSystemFont,\"SF Pro Text\",system-ui,sans-serif;color:#6C6C70;margin-left:3px}.ds-delta{font:600 12px -apple-system,BlinkMacSystemFont,\"SF Pro Text\",system-ui,sans-serif;font-variant-numeric:tabular-nums;color:#007A4C}"
